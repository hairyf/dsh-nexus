model Supervisor {
  bindings RoleBinding[]
  id String @id

  sessionId String?

  title String

  reason String

  status    SupervisorStatus @default(active)
  createdAt String
  closedAt  String?

  tickets SupervisorTicket[]

  @@index([status])
  @@map("supervisor")
}

model SupervisorTicket {
  supervisorId String
  ticketId     String
  createdAt    String

  supervisor Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  ticket     Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([supervisorId, ticketId])
  @@index([ticketId])
  @@map("supervisor_ticket")
}

enum SupervisorStatus {
  active
  closed
}
