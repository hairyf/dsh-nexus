model Channel {
  id      String  @id
  name    String
  enabled Boolean @default(false)

  host String?

  createdAt String

  accounts ChannelAccount[]
  threads  Thread[]
  triggers Trigger[]
  tickets  Ticket[]
  ciWatch  CiWatch[]
  states   SourceState[]

  @@map("channel")
}

model ChannelAccount {
  id        String        @id
  channelId String
  role      AccountRole
  name      String
  avatar    String?
  status    AccountStatus @default(offline)
  createdAt String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, role, name])
  @@index([channelId, role])
  @@map("channel_account")
}

model CiWatch {
  id String @id

  channelId String

  kind String

  ref String

  fingerprint String

  revision Int @default(0)

  head String?

  updatedAt String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, kind, ref])
  @@map("ci_watch")
}

enum AccountRole {
  bot
  admin
}

enum AccountStatus {
  online
  offline
}

model SourceState {
  channelId String
  name      String

  value String

  updatedAt String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, name])
  @@index([updatedAt])
  @@map("source_state")
}
