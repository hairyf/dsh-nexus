enum TicketLinkKind {
  depends
  relates
}

model Ticket {
  transitions TicketTransition[]
  asks AskTicket[]
  policyChanges PolicyChange[]
  bindings RoleBinding[]
  messages Message[]
  outbox Outbox[]
  acceptances Acceptance[]
  wakeups Wakeup[] @relation("WakeupOwner")
  wakes Wakeup[] @relation("WakeupRelated")
  attention Attention[]
  id          String       @id
  projectId   String
  channelId   String
  title       String
  description String?
  status      TicketStatus
  createdAt   String
  updatedAt   String
  acceptanceCriteria String @default("")
  authorization String @default("")
  questionLevel String @default("important")
  mergePolicy String @default("human_required")
  policyRevision Int @default(0)
  pauseReason String?
  pauseActor String?
  pausedAt String?
  failureReason String?
  deliveryTarget String?
  startedAt   String?
  endedAt     String?

  prUrl   String?
  prState PullRequestState?
  ciState CiState?

  paused Boolean @default(false)

  prepareError String?

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel     Channel            @relation(fields: [channelId], references: [id])
  threads     TicketThread[]
  links       TicketLink[]       @relation("LinkOwner")
  linkedBy    TicketLink[]       @relation("LinkTarget")
  workers     Worker[]
  supervisors SupervisorTicket[]

  @@index([projectId, status])
  @@index([status, updatedAt])
  @@map("ticket")
}

model TicketThread {
  ticketId  String
  threadId  String
  createdAt String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([ticketId, threadId])
  @@index([ticketId, createdAt])
  @@index([threadId])
  @@map("ticket_thread")
}

model TicketLink {
  ticketId  String
  relatedId String
  kind      TicketLinkKind
  satisfiedAt String?
  wakeupId String?
  createdAt String

  ticket  Ticket @relation("LinkOwner", fields: [ticketId], references: [id], onDelete: Cascade)
  related Ticket @relation("LinkTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([ticketId, relatedId, kind])
  @@index([relatedId])
  @@map("ticket_link")
}

enum TicketStatus {
  waiting
  queued
  running
  review
  done
  cancelled
}

enum PullRequestState {
  open
  merged
  closed
}

enum CiState {
  pending
  running
  passing
  failing
}
