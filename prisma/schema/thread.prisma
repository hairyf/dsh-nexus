enum ThreadKind {
  issue
  pull
  chat
  ci
}

enum ThreadTriage {
  pending
  claimed
  ignored
}

enum TriggerKind {
  comment
  open
  close
  ci
  push
}

model Thread {
  repository String?
  attentionReason String?
  messages Message[] @relation("MessageSource")
  destinations Message[] @relation("MessageDestination")
  id        String     @id
  channelId String
  projectId String?
  refId     String
  kind      ThreadKind
  title     String
  url       String?
  createdAt String
  updatedAt String

  triage    ThreadTriage @default(pending)
  triagedAt String?

  channel  Channel        @relation(fields: [channelId], references: [id])
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  triggers Trigger[]
  tickets  TicketThread[]

  @@unique([channelId, refId])
  @@index([updatedAt])
  @@index([projectId])
  @@index([triage])
  @@map("thread")
}

model Trigger {
  messages Message[]
  id        String      @id
  channelId String
  threadId  String
  kind      TriggerKind
  actorProviderId String?
  actorLogin String?
  actorSource String?
  outbound Boolean @default(false)
  actorName String?
  human     Boolean     @default(true)
  mentioned Boolean     @default(false)
  text      String
  url       String?
  at        String

  ref String?

  channel Channel @relation(fields: [channelId], references: [id])
  thread  Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, at])
  @@index([channelId, at])
  @@index([at])
  @@index([ref])
  @@map("trigger")
}
