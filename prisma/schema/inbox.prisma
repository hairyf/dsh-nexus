model Inbox {
  id String @id
  seq Int @unique
  recipient String
  sender String
  kind String
  title String?
  content String
  askId String?
  acceptedAt String
  readAt String?
  handledAt String?
  notifiedAt String?
  supersededAt String?
  @@index([recipient, handledAt, seq])
  @@map("inbox")
}
