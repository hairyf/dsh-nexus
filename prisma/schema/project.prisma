/// 一个项目对应一个 DSH Git 工作区；消息渠道不是项目存在的前提。
model Project {
  id                    String  @id
  /// 工作区显示名；同名工作区允许存在，不作为仓库身份。
  name                  String
  /// 一个工作区最多对应一个项目。
  workspaceId           String  @unique
  /// 本地 Git 工作区目录。
  directory             String
  /// Git remote 地址；可空以兼容历史，自动发现候选须配置 remote。
  remoteUrl             String?
  /// 是否纳入 Nexus 编排范围；工作区同步不得覆盖人工选择。
  enabled               Boolean @default(true)
  /// 最近一次项目编排会话。
  orchestratorSessionId String?
  createdAt             String
  updatedAt             String

  threads Thread[]
  tickets Ticket[]
  inbox   Inbox[]

  @@map("project")
}
