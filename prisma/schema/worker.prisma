model Worker {
  id          String           @id
  ticketId    String
  status      WorkerStatus
  createdAt   String
  startedAt   String?
  endedAt     String?
  title       String?
  endedReason WorkerEndReason?

  branch   String?
  worktree String?

  reportState ReportState?
  report      String?
  reportAt    String?

  backgroundUntil String?

  recoveryNote String?

  ticket Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([status])
  @@map("worker")
}

enum WorkerStatus {
  queued
  running
  ended
}

enum WorkerEndReason {
  completed
  stopped
  failed
  restarted
}

enum ReportState {
  progress
  ready
  failed
  dropped
}
