model Setting {
  id String @id
  maxWorkers Int @default(4)
  backgroundLimitMinutes Int @default(30)
  defaultQuestionLevel String @default("important")
  defaultMergePolicy String @default("follow_question_level")
  whitelist String @default("[]")
  reminderIntervalMinutes Int @default(10)
  deliveryMaxAttempts Int @default(3)
  deliveryRetryCeilingSeconds Int @default(60)
  updatedAt String
  @@map("setting")
}
